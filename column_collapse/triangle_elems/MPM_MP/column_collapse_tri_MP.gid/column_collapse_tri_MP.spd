        <value n="Y_Constraint_liq" pn="y direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction"/>
        <value n="Z_Constraint_liq" pn="z direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction" state="[check_dim 3D 3D:Axissymmetric %W]"/>
      </condition>
      <condition n="gas_fixities" pn="Gas Fixities" icon="icon_fixity" ov="point,line,surface" help="Use this condition to apply fixities associated only with the gas phase">
        <value n="X_Constraint_gas" pn="x direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction"/>
        <value n="Y_Constraint_gas" pn="y direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction"/>
        <value n="Z_Constraint_gas" pn="z direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction" state="[check_dim 3D 3D:Axissymmetric %W]"/>
      </condition>
