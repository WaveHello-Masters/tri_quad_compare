      <!-- SOLID TRACTION -->
      <condition n="Solid_traction" pn="Solid traction" icon="icon_load" ov="[check_dim_line_surface 2D:plane-strain 2D:Axissymmetric %W]" ovm="face_element" help="Use this condition to apply a load on solid">
        <value n="Local_axes" pn="Local axes" v="0" values="0,1" editable="0" local_axes="disabled" help="If the direction to define is not coincident with the global axes, it is possible to define a set of local axes and prescribe the load related to that local axes">
          <dependencies node="." att1="local_axes" v1="normal" value="1"/>
          <dependencies node="." att1="local_axes" v1="disabled" not_value="1"/>
        </value>
        <value n="loading_distribution" pn="loading distribution" v="uniform" values="uniform,linear" actualize_tree="1">
          <dependencies node="../value[@n='X_direction']" att1="state" v1="normal" value="uniform"/>
          <dependencies node="../value[@n='X_direction']" att1="state" v1="hidden" value="linear"/>
          <dependencies node="../value[@n='Y_direction']" att1="state" v1="normal" value="uniform"/>
          <dependencies node="../value[@n='Y_direction']" att1="state" v1="hidden" value="linear"/>
          <dependencies node="../value[@n='Z_direction']" att1="state" v1="[check_dim 3D 3D:Axissymmetric %W]" value="uniform"/>
          <dependencies node="../value[@n='Z_direction']" att1="state" v1="hidden" value="linear"/>
          <dependencies node="../value[@n='reference_point_X_coord']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='reference_point_X_coord']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='reference_point_Y_coord']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='reference_point_Y_coord']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='reference_point_Z_coord']" att1="state" v1="[check_dim 3D 3D:Axissymmetric %W]" value="linear"/>
          <dependencies node="../value[@n='reference_point_Z_coord']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='tractionX_at_reference_point']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='tractionX_at_reference_point']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='tractionY_at_reference_point']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='tractionY_at_reference_point']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='tractionZ_at_reference_point']" att1="state" v1="[check_dim 3D 3D:Axissymmetric %W]" value="linear"/>
          <dependencies node="../value[@n='tractionZ_at_reference_point']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='gradientX_of_tractionX']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='gradientX_of_tractionX']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='gradientY_of_tractionX']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='gradientY_of_tractionX']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='gradientZ_of_tractionX']" att1="state" v1="[check_dim 3D 3D:Axissymmetric %W]" value="linear"/>
          <dependencies node="../value[@n='gradientZ_of_tractionX']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='gradientX_of_tractionY']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='gradientX_of_tractionY']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='gradientY_of_tractionY']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='gradientY_of_tractionY']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='gradientZ_of_tractionY']" att1="state" v1="[check_dim 3D 3D:Axissymmetric %W]" value="linear"/>
          <dependencies node="../value[@n='gradientZ_of_tractionY']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='gradientX_of_tractionZ']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='gradientX_of_tractionZ']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='gradientY_of_tractionZ']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='gradientY_of_tractionZ']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='gradientZ_of_tractionZ']" att1="state" v1="[check_dim 3D 3D:Axissymmetric %W]" value="linear"/>
          <dependencies node="../value[@n='gradientZ_of_tractionZ']" att1="state" v1="hidden" value="uniform"/>
        </value>
        <value n="X_direction" pn="x direction [kPa]" v="0.0" state="hidden"/>
        <value n="Y_direction" pn="y direction [kPa]" v="0.0" state="hidden"/>
        <value n="Z_direction" pn="z direction [kPa]" v="0.0" state="[check_dim 3D 3D:Axissymmetric %W]"/>
        <value n="reference_point_X_coord" pn="reference point X coord" v="0.0" state="hidden"/>
        <value n="reference_point_Y_coord" pn="reference point Y coord" v="0.0" state="hidden"/>
        <value n="reference_point_Z_coord" pn="reference point Z coord" v="0.0" state="hidden"/>
        <value n="tractionX_at_reference_point" pn="tractionX at reference point [kPa]" v="0.0" state="hidden"/>
        <value n="tractionY_at_reference_point" pn="tractionY at reference point [kPa]" v="0.0" state="hidden"/>
        <value n="tractionZ_at_reference_point" pn="tractionZ at reference point [kPa]" v="0.0" state="hidden"/>
        <value n="gradientX_of_tractionX" pn="gradientX of tractionX" v="0.0" state="hidden"/>
        <value n="gradientY_of_tractionX" pn="gradientY of tractionX" v="0.0" state="hidden"/>
        <value n="gradientZ_of_tractionX" pn="gradientZ of tractionX" v="0.0" state="hidden"/>
        <value n="gradientX_of_tractionY" pn="gradientX of tractionY" v="0.0" state="hidden"/>
        <value n="gradientY_of_tractionY" pn="gradientY of tractionY" v="0.0" state="hidden"/>
        <value n="gradientZ_of_tractionY" pn="gradientZ of tractionY" v="0.0" state="hidden"/>
        <value n="gradientX_of_tractionZ" pn="gradientX of tractionZ" v="0.0" state="[check_dim 3D 3D:Axissymmetric %W]"/>
        <value n="gradientY_of_tractionZ" pn="gradientY of tractionZ" v="0.0" state="[check_dim 3D 3D:Axissymmetric %W]"/>
        <value n="gradientZ_of_tractionZ" pn="gradientZ of tractionZ" v="0.0" state="[check_dim 3D 3D:Axissymmetric %W]"/>
        <value n="apply_traction_on" pn="apply traction on" v="nodes" values="nodes,material points"/>
        <value n="load_system_" pn="load system" v="A" values="A,B"/>
      </condition>
      <!-- LIQUID PRESSURE -->
      <condition n="Liquid_Pressure" pn="Liquid pressure" icon="icon_load" ov="[check_dim_line_surface 2D:plane-strain 2D:Axissymmetric %W]" ovm="face_element" help="Use this condition to apply a liquid pressure">
        <value n="all_directions" pn="all directions" v="uniform" values="uniform,linear" actualize_tree="1">
          <dependencies node="../value[@n='pressure']" att1="state" v1="normal" value="uniform"/>
          <dependencies node="../value[@n='pressure']" att1="state" v1="hidden" value="linear"/>
          <dependencies node="../value[@n='pressure_at_reference_point']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='pressure_at_reference_point']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='reference_point_X_coord_']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='reference_point_X_coord_']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='reference_point_Y_coord_']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='reference_point_Y_coord_']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='reference_point_Z_coord_']" att1="state" v1="[check_dim 3D 3D:Axissymmetric %W]" value="linear"/>
          <dependencies node="../value[@n='reference_point_Z_coord_']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='gradientX']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='gradientX']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='gradientY']" att1="state" v1="normal" value="linear"/>
          <dependencies node="../value[@n='gradientY']" att1="state" v1="hidden" value="uniform"/>
          <dependencies node="../value[@n='gradientZ']" att1="state" v1="[check_dim 3D 3D:Axissymmetric %W]" value="linear"/>
          <dependencies node="../value[@n='gradientZ']" att1="state" v1="hidden" value="uniform"/>
        </value>
        <value n="pressure" pn="pressure [kPa]" v="0.0"/>
        <value n="pressure_at_reference_point" pn="pressure at reference point [kPa]" v="0.0"/>
        <value n="reference_point_X_coord_" pn="reference point X coord" v="0.0" state="hidden"/>
        <value n="reference_point_Y_coord_" pn="reference point Y coord" v="0.0" state="hidden"/>
        <value n="reference_point_Z_coord_" pn="reference point Z coord" v="0.0" state="hidden"/>
        <value n="gradientX" pn="gradientX" v="0.0" state="hidden"/>
        <value n="gradientY" pn="gradientY" v="0.0" state="hidden"/>
        <value n="gradientZ" pn="gradientZ" v="0.0" state="hidden"/>
        <value n="apply_pressure_on" pn="apply pressure on" v="nodes" values="nodes,material points"/>
        <value n="load_system" pn="load system" v="A" values="A,B"/>
      </condition>
    </container>
    <container n="Prescribed_velocity" pn="Prescribed Velocity" icon="icon_velocity" actualize_tree="1">
      <!-- NODAL PRESCIBED VELOCITY -->
      <condition n="Nodal_prescribed_velocity" pn="Nodal velocity" icon="icon_velocity" ov="[check_dim_prescribed_velocity 2D:plane-strain 2D:Axissymmetric %W]" ovm="node" help="Use this condition to apply a prescribed velocity on nodes">
        <value n="X_velocity_node" pn="x direction" v="0" values="1,0" help="OFF = free direction, ON = prescribed velocity direction" actualize_tree="1">
          <dependencies node="../value[@n='X_velocity_[m/s]']" att1="state" v1="normal" value="1"/>
          <dependencies node="../value[@n='X_velocity_[m/s]']" att1="state" v1="hidden" value="0"/>
        </value>
        <value n="X_velocity_[m/s]" pn="velocity [m/s]" v="0.0" state="hidden"/>
        <value n="Y_velocity_node" pn="y direction" v="0" values="1,0" help="OFF = free direction, ON = prescribed velocity direction" actualize_tree="1">
          <dependencies node="../value[@n='Y_velocity_[m/s]']" att1="state" v1="normal" value="1"/>
          <dependencies node="../value[@n='Y_velocity_[m/s]']" att1="state" v1="hidden" value="0"/>
        </value>
        <value n="Y_velocity_[m/s]" pn="velocity [m/s]" v="0.0" state="hidden"/>
        <value n="Z_velocity_node" pn="z direction" v="0" values="1,0" help="OFF = free direction, ON = prescribed velocity direction" state="[check_dim 3D 3D:Axissymmetric %W]" actualize_tree="1">
          <dependencies node="../value[@n='Z_velocity_[m/s]']" att1="state" v1="normal" value="1"/>
          <dependencies node="../value[@n='Z_velocity_[m/s]']" att1="state" v1="hidden" value="0"/>
        </value>
        <value n="Z_velocity_[m/s]" pn="velocity [m/s]" v="0.0" state="hidden"/>
      </condition>
      <!-- MATERIAL POINT PRESCIBED VELOCITY -->
      <condition n="MP_prescribed_velocity" pn="Material point velocity" icon="icon_velocity" ov="[check_dim_surface_volume 2D:plane-strain 2D:Axissymmetric %W]" ovm="element" help="Use this condition to apply a prescribed velocity on material points - Note: Only in combination with moving mesh! Prescribed velocity has to be in moving mesh direction">
        <value n="X_velocity_MP" pn="x direction" v="0" values="1,0" help="OFF = free direction, ON = prescribed velocity direction" actualize_tree="1">
          <dependencies node="../value[@n='X_velocity_[m/s]']" att1="state" v1="normal" value="1"/>
          <dependencies node="../value[@n='X_velocity_[m/s]']" att1="state" v1="hidden" value="0"/>
        </value>
        <value n="X_velocity_[m/s]" pn="velocity [m/s]" v="0.0" state="hidden"/>
        <value n="Y_velocity_MP" pn="y direction" v="0" values="1,0" help="OFF = free direction, ON = prescribed velocity direction" actualize_tree="1">
          <dependencies node="../value[@n='Y_velocity_[m/s]']" att1="state" v1="normal" value="1"/>
          <dependencies node="../value[@n='Y_velocity_[m/s]']" att1="state" v1="hidden" value="0"/>
        </value>
        <value n="Y_velocity_[m/s]" pn="velocity [m/s]" v="0.0" state="hidden"/>
        <value n="Z_velocity_MP" pn="z direction" v="0" values="1,0" help="OFF = free direction, ON = prescribed velocity direction" state="[check_dim 3D 3D:Axissymmetric %W]" actualize_tree="1">
          <dependencies node="../value[@n='Z_velocity_[m/s]']" att1="state" v1="normal" value="1"/>
          <dependencies node="../value[@n='Z_velocity_[m/s]']" att1="state" v1="hidden" value="0"/>
        </value>
        <value n="Z_velocity_[m/s]" pn="velocity [m/s]" v="0.0" state="hidden" actualize_tree="1"/>
      </condition>
    </container>
    <container n="Hydraulic_Conditions" pn="Hydraulic Conditions" icon="icon_hydraulicBC">
      <!-- HYDRAULIC HEAD -->
      <container n="Hydraulic_head" pn="Hydraulic head" icon="icon_hydraulicBC">
        <condition n="Minimum_coordinates_hydraulic_head_2D" pn="x- and y-min" icon="icon_hydraulicBC" ov="point" ovm="node" state="[check_dim 2D:plane-strain 2D:Axissymmetric %W]" help="Assign the point of hydraulic head area with minimum coordinates"/>
        <condition n="Maximum_coordinates_hydraulic_head_2D" pn="x- and y-max" icon="icon_hydraulicBC" ov="point" ovm="node" state="[check_dim 2D:plane-strain 2D:Axissymmetric %W]" help="Assign the point of hydraulic head area with maximum coordinates"/>
        <condition n="Minimum_coordinates_hydraulic_head_3D" pn="x- y- and z-min" icon="icon_hydraulicBC" ov="point" ovm="node" state="[check_dim 3D 3D:Axissymmetric %W]" help="Assign the point of hydraulic head area with minimum coordinates"/>
        <condition n="Maximum_coordinates_hydraulic_head_3D" pn="x- y- and z-max" icon="icon_hydraulicBC" ov="point" ovm="node" state="[check_dim 3D 3D:Axissymmetric %W]" help="Assign the point of hydraulic head area with maximum coordinates"/>
      </container>
      <!-- SEEPAGE FACE -->
      <container n="Seepage_face" pn="Seepage face" icon="icon_hydraulicBC">
        <condition n="Minimum_coordinates_seepage_face_2D" pn="x- and y-min" icon="icon_hydraulicBC" ov="point" ovm="node" state="[check_dim 2D:plane-strain 2D:Axissymmetric %W]" help="Assign the point of seepage face area with minimum coordinates"/>
        <condition n="Maximum_coordinates_seepage_face_2D" pn="x- and y-max" icon="icon_hydraulicBC" ov="point" ovm="node" state="[check_dim 2D:plane-strain 2D:Axissymmetric %W]" help="Assign the point of seepage face area with maximum coordinates"/>
        <condition n="Minimum_coordinates_seepage_face_3D" pn="x- y- and z-min" icon="icon_hydraulicBC" ov="point" ovm="node" state="[check_dim 3D 3D:Axissymmetric %W]" help="Assign the point of seepage face area with minimum coordinates"/>
        <condition n="Maximum_coordinates_seepage_face_3D" pn="x- y- and z-max" icon="icon_hydraulicBC" ov="point" ovm="node" state="[check_dim 3D 3D:Axissymmetric %W]" help="Assign the point of seepage face area with maximum coordinates"/>
      </container>
      <!-- INFILTRATION -->
      <container n="Infiltration" pn="Infiltration" icon="icon_hydraulicBC">
        <condition n="Minimum_coordinates_infiltration_2D" pn="x- and y-min" icon="icon_hydraulicBC" ov="point" ovm="node" state="[check_dim 2D:plane-strain 2D:Axissymmetric %W]" help="Assign the point of infiltration area with minimum coordinates"/>
        <condition n="Maximum_coordinates_infiltration_2D" pn="x- and y-max" icon="icon_hydraulicBC" ov="point" ovm="node" state="[check_dim 2D:plane-strain 2D:Axissymmetric %W]" help="Assign the point of infiltration area with maximum coordinates"/>
        <condition n="Minimum_coordinates_infiltration_3D" pn="x- y- and z-min" icon="icon_hydraulicBC" ov="point" ovm="node" state="[check_dim 3D 3D:Axissymmetric %W]" help="Assign the point of infiltration area with minimum coordinates"/>
        <condition n="Maximum_coordinates_infiltration_3D" pn="x- y- and z-max" icon="icon_hydraulicBC" ov="point" ovm="node" state="[check_dim 3D 3D:Axissymmetric %W]" help="Assign the point of infiltration area with maximum coordinates"/>
        <container n="Infiltration_rate_value" pn="Infiltration rate value" icon="icon_hydraulicBC">
          <value n="X_direction" pn="x direction [m/s]" v="0.0" state="normal"/>
          <value n="Y_direction" pn="y direction [m/s]" v="0.0" state="normal"/>
          <value n="Z_direction" pn="z direction [m/s]" v="0.0" state="[check_dim 3D 3D:Axissymmetric %W]"/>
        </container>
      </container>
    </container>
  </container>
  <!-- ############ Initial and BC ############ -->
  <container n="Initial_cond" pn="Initial conditions" icon="" help="Specify initial and boundary conditions for the problem." tree_state="close">
    <condition n="Initial_MP_velocity" pn="Initial Velocity (on material points)" icon="icon_initial" ov="[check_dim_surface_volume 2D:plane-strain 2D:Axissymmetric %W]" ovm="element" help="Use this condition to apply an initial velocity on material points">
      <value n="X_direction" pn="x direction [m/s]" v="0.0"/>
      <value n="Y_direction" pn="y direction [m/s]" v="0.0"/>
      <value n="Z_direction" pn="z direction [m/s]" v="0.0" state="[check_dim 3D 3D:Axissymmetric %W]" actualize_tree="1"/>
    </condition>
    <condition n="Soil_surface" pn="Soil Surface" ov="line" ovm="face_element" icon="icon_soil_surface" help="Select lines of geometry to assign the initial soil surface" state="[check_dim 2D:plane-strain 2D:Axissymmetric %W]"/>
    <container n="Phreatic_surface" pn="Phreatic Surface" icon="icon_phreatic">
      <condition n="Phreatic_surface_line" pn="Select water table profile" icon="icon_phreatic" ov="line" ovm="face_element" help="Select lines of geometry to define the initial phreatic surface" state="[check_dim 2D:plane-strain 2D:Axissymmetric %W]"/>
      <blockdata n="Phreatic_surface_file" name="Water table from file PSF_1" sequence="1" editable_name="unique" morebutton="0" icon="icon_phreatic">
        <value n="Phreatic_surface_file_flag" pn="Assign water table from external file" icon="icon_phreatic" values="no,yes" v="no" state="normal"/>
        <value n="Number_of_materials" pn="Number of materials" icon="icon_phreatic" values="please specify,1,2,3,4,5" v="please specify" state="normal">
          <dependencies node="../value[@n='material_phreatic_surface_file1']" att1="state" v1="hidden" value="please specify"/>
          <dependencies node="../value[@n='material_phreatic_surface_file1']" att1="state" v1="normal" value="1"/>
          <dependencies node="../value[@n='material_phreatic_surface_file1']" att1="state" v1="normal" value="2"/>
          <dependencies node="../value[@n='material_phreatic_surface_file1']" att1="state" v1="normal" value="3"/>
          <dependencies node="../value[@n='material_phreatic_surface_file1']" att1="state" v1="normal" value="4"/>
          <dependencies node="../value[@n='material_phreatic_surface_file1']" att1="state" v1="normal" value="5"/>
          <dependencies node="../value[@n='material_phreatic_surface_file2']" att1="state" v1="hidden" value="please specify"/>
          <dependencies node="../value[@n='material_phreatic_surface_file2']" att1="state" v1="hidden" value="1"/>
          <dependencies node="../value[@n='material_phreatic_surface_file2']" att1="state" v1="normal" value="2"/>
          <dependencies node="../value[@n='material_phreatic_surface_file2']" att1="state" v1="normal" value="3"/>
          <dependencies node="../value[@n='material_phreatic_surface_file2']" att1="state" v1="normal" value="4"/>
          <dependencies node="../value[@n='material_phreatic_surface_file2']" att1="state" v1="normal" value="5"/>
          <dependencies node="../value[@n='material_phreatic_surface_file3']" att1="state" v1="hidden" value="please specify"/>
          <dependencies node="../value[@n='material_phreatic_surface_file3']" att1="state" v1="hidden" value="1"/>
          <dependencies node="../value[@n='material_phreatic_surface_file3']" att1="state" v1="hidden" value="2"/>
          <dependencies node="../value[@n='material_phreatic_surface_file3']" att1="state" v1="normal" value="3"/>
          <dependencies node="../value[@n='material_phreatic_surface_file3']" att1="state" v1="normal" value="4"/>
          <dependencies node="../value[@n='material_phreatic_surface_file3']" att1="state" v1="normal" value="5"/>
          <dependencies node="../value[@n='material_phreatic_surface_file4']" att1="state" v1="hidden" value="please specify"/>
          <dependencies node="../value[@n='material_phreatic_surface_file4']" att1="state" v1="hidden" value="1"/>
          <dependencies node="../value[@n='material_phreatic_surface_file4']" att1="state" v1="hidden" value="2"/>
          <dependencies node="../value[@n='material_phreatic_surface_file4']" att1="state" v1="hidden" value="3"/>
          <dependencies node="../value[@n='material_phreatic_surface_file4']" att1="state" v1="normal" value="4"/>
          <dependencies node="../value[@n='material_phreatic_surface_file4']" att1="state" v1="normal" value="5"/>
          <dependencies node="../value[@n='material_phreatic_surface_file5']" att1="state" v1="hidden" value="please specify"/>
          <dependencies node="../value[@n='material_phreatic_surface_file5']" att1="state" v1="hidden" value="1"/>
          <dependencies node="../value[@n='material_phreatic_surface_file5']" att1="state" v1="hidden" value="2"/>
          <dependencies node="../value[@n='material_phreatic_surface_file5']" att1="state" v1="hidden" value="3"/>
          <dependencies node="../value[@n='material_phreatic_surface_file5']" att1="state" v1="hidden" value="4"/>
          <dependencies node="../value[@n='material_phreatic_surface_file5']" att1="state" v1="normal" value="5"/>
        </value>
        <value n="material_phreatic_surface_file1" pn="Material 1" editable="0" help="Choose a material from the database" values="[ANURA3D_2023::GetMaterialsList %W]" v="specify" state="hidden" icon="icon_phreatic">
          <edit_command n="Edit materials" pn="Edit materials" icon="darkorange-block1.png" proc="ANURA3D_2023::EditDatabaseListDirect %W %DICT %BC"/>
        </value>
        <value n="material_phreatic_surface_file2" pn="Material 2" editable="0" help="Choose a material from the database" values="[ANURA3D_2023::GetMaterialsList %W]" v="specify" state="hidden" icon="icon_phreatic">
          <edit_command n="Edit materials" pn="Edit materials" icon="darkorange-block1.png" proc="ANURA3D_2023::EditDatabaseListDirect %W %DICT %BC"/>
        </value>
        <value n="material_phreatic_surface_file3" pn="Material 3" editable="0" help="Choose a material from the database" values="[ANURA3D_2023::GetMaterialsList %W]" v="specify" state="hidden" icon="icon_phreatic">
          <edit_command n="Edit materials" pn="Edit materials" icon="darkorange-block1.png" proc="ANURA3D_2023::EditDatabaseListDirect %W %DICT %BC"/>
        </value>
        <value n="material_phreatic_surface_file4" pn="Material 4" editable="0" help="Choose a material from the database" values="[ANURA3D_2023::GetMaterialsList %W]" v="specify" state="hidden" icon="icon_phreatic">
          <edit_command n="Edit materials" pn="Edit materials" icon="darkorange-block1.png" proc="ANURA3D_2023::EditDatabaseListDirect %W %DICT %BC"/>
        </value>
        <value n="material_phreatic_surface_file5" pn="Material 5" editable="0" help="Choose a material from the database" values="[ANURA3D_2023::GetMaterialsList %W]" v="specify" state="hidden" icon="icon_phreatic">
          <edit_command n="Edit materials" pn="Edit materials" icon="darkorange-block1.png" proc="ANURA3D_2023::EditDatabaseListDirect %W %DICT %BC"/>
        </value>
      </blockdata>
    </container>
  </container>
