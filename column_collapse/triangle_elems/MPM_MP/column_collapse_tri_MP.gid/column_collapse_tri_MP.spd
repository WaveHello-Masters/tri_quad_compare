    <container n="Remove_Fixities" pn="Remove Fixities" icon="icon_remove" help="Use this condition to set the remove fixities feature">
      <condition n="remove_solid_fixities" pn="Remove Solid Fixities" icon="icon_remove" ov="point,line,surface" ovm="node" help="Use this condition to remove fixities associated only with solid phase materials">
        <value n="X_Constraint" pn="x direction" v="0" values="1,0" help="OFF = keep fixity, ON = remove fixity"/>
