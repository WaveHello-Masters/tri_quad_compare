    <blockdata n="material" name="Column" sequence="1" editable_name="unique" morebutton="0" icon="icon_material" state="normal">
      <container n="_basic" pn="BASIC PROPERTIES">
        <value n="material_type_" pn="Material type" v="Dry material" values="Dry material,Saturated material-drained,Saturated material-undrained effective stress,Saturated material-undrained total stress,Saturated material-fully coupled,Unsaturated material-2-phase with suction effect,Unsaturated material-3-phase fully coupled,Liquid" actualize_tree="1" state="normal"/>
