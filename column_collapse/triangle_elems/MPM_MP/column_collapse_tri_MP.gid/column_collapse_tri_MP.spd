  <!-- ############ Initial and BC ############ -->
  <container n="BC" pn="Boundary conditions" icon="" help="Specify initial and boundary conditions for the problem." tree_state="close">
    <container n="Fixities" pn="Fixities" icon="icon_fixity" help="Use this condition to set the fixities of the problem">
      <condition n="solid_fixities" pn="Solid Fixities" icon="icon_fixity" ov="point,line,surface" ovm="node" help="Use this condition to apply fixities associated only with solid phase materials">
        <value n="X_Constraint" pn="x direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction"/>
        <value n="Y_Constraint" pn="y direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction"/>
        <value n="Z_Constraint" pn="z direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction" state="[check_dim 3D 3D:Axissymmetric %W]"/>
        <group n="Solid Fixities Auto5" ov="line" tree_state="close">
          <value n="X_Constraint" pn="x direction" v="1" values="1,0" help="OFF = free direction, ON = fixed direction" state="normal"/>
          <value n="Y_Constraint" pn="y direction" v="1" values="1,0" help="OFF = free direction, ON = fixed direction" state="normal"/>
          <value n="Z_Constraint" pn="z direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction" state="[check_dim 3D 3D:Axissymmetric %W]"/>
        </group>
        <group n="Solid Fixities Auto6" ov="line" tree_state="close">
          <value n="X_Constraint" pn="x direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction" state="normal"/>
          <value n="Y_Constraint" pn="y direction" v="1" values="1,0" help="OFF = free direction, ON = fixed direction" state="normal"/>
          <value n="Z_Constraint" pn="z direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction" state="[check_dim 3D 3D:Axissymmetric %W]"/>
        </group>
        <group n="Solid Fixities Auto7" ov="line" tree_state="close">
          <value n="X_Constraint" pn="x direction" v="1" values="1,0" help="OFF = free direction, ON = fixed direction" state="normal"/>
          <value n="Y_Constraint" pn="y direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction" state="normal"/>
          <value n="Z_Constraint" pn="z direction" v="0" values="1,0" help="OFF = free direction, ON = fixed direction" state="[check_dim 3D 3D:Axissymmetric %W]"/>
        </group>
      </condition>
      <condition n="liquid_fixities" pn="Liquid Fixities" icon="icon_fixity" ov="point,line,surface" help="Use this condition to apply fixities associated only with the liquid phase">
