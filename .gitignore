# Files that git should ignore

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
# *.out
*.app
# Python files
*.pyc

# Ignoring Anura3D files
*.CPS*
!*.CPS_001
*.GIP*
*.BRF*
*.vtk
*.INF
*.MLG
*.ENG
*.RX
*.BMR
*.BMS
*.TST
*.PAR*
*.bat
